# Local backend settings. Set this to your installed Stockfish executable.
STOCKFISH_PATH=C:/path/to/stockfish.exe
ENGINE_COUNT=1
HASH_MB=16
MAX_QUEUE=12

# Local SQLite database; no separate database server is needed.
DATABASE_URL=sqlite+aiosqlite:///./chessbuddy.db
ALLOWED_ORIGINS=http://localhost:3000
# ALLOWED_ORIGIN_REGEX=https://your-project-.*\.vercel\.app

PLAY_MOVETIME_CAP=1.0
ANALYSIS_DEPTH_CAP=18
MULTIPV_CAP=3
REVIEW_DEPTH=14
MOOD_DEPTH=10

COACH_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_HISTORY_TURNS=6
FACTS_DEPTH=14
